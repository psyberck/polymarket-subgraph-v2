# Commented-out lines are optional and show the default.

# ── Envio ──────────────────────────────────────────────────────────
# Envio start block id
# ENVIO_START_BLOCK=85050370

# Postgres schema the indexer writes to; use a separate one for side-by-side test runs.
# ENVIO_PG_SCHEMA=public

# Port of the indexer's HTTP server; change it when running a second indexer.
# ENVIO_INDEXER_PORT=9898

# Terminal UI; keep false for unattended runs — with the TUI on, envio never exits at end_block.
# ENVIO_TUI=false

# Hasura GraphQL; set false for throwaway indexers so they don't touch its metadata.
# ENVIO_HASURA=true

# ── Postgres (self-hosted only) ────────────────────────────────────
# Leave unset for the local envio container: envio then uses localhost:5433.
# ENVIO_PG_HOST=

# Port; envio and scripts/utils/postgres.ts to 5433.
# ENVIO_PG_PORT=5433

# Database user.
# ENVIO_PG_USER=postgres

# Database password (envio and scripts/utils/postgres.ts default to "testing").
# ENVIO_PG_PASSWORD=

# Database name.
# ENVIO_PG_DATABASE=envio-dev

# TLS mode as envio reads it: require | allow | prefer | verify-full (off when unset locally).
# ENVIO_PG_SSL_MODE=require

# Container name `docker exec` into when ENVIO_PG_HOST is unset.
# ENVIO_PG_CONTAINER=envio-postgres

# ── ClickHouse sink (required while @storage.clickhouse is true) ────
# Full URL, not a bare hostname, e.g. http://localhost:8123.
ENVIO_CLICKHOUSE_HOST=http://localhost:8123

# ClickHouse user.
ENVIO_CLICKHOUSE_USERNAME=default

# ClickHouse password; empty is valid for a container started without user setup.
ENVIO_CLICKHOUSE_PASSWORD=

# ClickHouse database; defaults to "default".
ENVIO_CLICKHOUSE_DATABASE=default

# ── RPC ────────────────────────────────────────────────────────────
# Polygon RPC endpoint
POLYGON_RPC_URL=http://127.0.0.1:8546

# Upstream the proxy forwards to (scripts/rpc_proxy.mjs).
PROXY_UPSTREAM=https://polygon.gateway.tenderly.co

# Port the proxy listens on; config.yaml's rpc.url must match.
# PROXY_PORT=8546

# Max in-flight upstream requests.
# PROXY_CONCURRENCY=3

# Retries per request on 429s and upstream errors.
# PROXY_MAX_RETRIES=12

# First retry backoff, in ms.
# PROXY_BASE_DELAY_MS=250

# Backoff ceiling, in ms.
# PROXY_MAX_DELAY_MS=15000

# ── Indexing behaviour ─────────────────────────────────────────────
# Book wallet-to-wallet CTF transfers (transfers-design.md §2); read at load, changing it needs a reindex.
INDEX_INCLUDE_P2P_TRANSFERS=false

# ── Snapshot supervisor ──────────────────
# Policy (schedule, pruning) is passed as flags to run_indexer.sh; these describe the machine.
# DuckDB memory cap for exports; beyond it DuckDB spills to its default .tmp in the indexer directory.
# DUCKDB_MEMORY_LIMIT=2GB

# DuckDB worker threads; the box also runs Postgres and Envio.
# DUCKDB_THREADS=2

# ── Scripts ────────────────────────────────────────────────────────
# Worker threads for scripts/init_conditions.ts (default: min(CPUs, 8)).
# WORKER_COUNT=
